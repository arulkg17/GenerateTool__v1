-- =============================================
-- GET ALL PAGED
-- =============================================
IF OBJECT_ID('dbo.sp_{{tablename}}_GetAllPaged','P') IS NOT NULL
DROP PROCEDURE [dbo].[sp_{{tablename}}_GetAllPaged];

GO

CREATE PROCEDURE [dbo].[sp_{{tablename}}_GetAllPaged]
(
{{~ for col in searchcolumns ~}}
    @{{col.name}} {{col.sqltype}} = NULL,
{{~ end ~}}
    @PageNumber INT = 1,
    @PageSize INT = 10
)

AS
BEGIN

SET NOCOUNT ON;

IF (@PageNumber <= 0)
    SET @PageNumber = 1;

IF (@PageSize <= 0)
    SET @PageSize = 10;

DECLARE @Offset INT;

SET @Offset = (@PageNumber - 1) * @PageSize;

SELECT
    *,
    COUNT(*) OVER() AS TotalRecords
FROM [dbo].[{{tablename}}]
WHERE 1 = 1

{{~ for col in searchcolumns ~}}
AND
(
    @{{col.name}} IS NULL
    OR
    [{{col.name}}] LIKE '%' + @{{col.name}} + '%'
)
{{~ end ~}}

ORDER BY Id
OFFSET @Offset ROWS
FETCH NEXT @PageSize ROWS ONLY;

SELECT
    COUNT(1) AS TotalRecords
FROM [dbo].[{{tablename}}]
WHERE 1 = 1

{{~ for col in searchcolumns ~}}
AND
(
    @{{col.name}} IS NULL
    OR
    [{{col.name}}] LIKE '%' + @{{col.name}} + '%'
)
{{~ end ~}}

END

GO