{{~ for proj in newprojects ~}}
{{~ if proj.buildable ~}}
		{{ proj.projectguid }}.Debug|Any CPU.ActiveCfg = Debug|Any CPU
		{{ proj.projectguid }}.Debug|Any CPU.Build.0 = Debug|Any CPU
		{{ proj.projectguid }}.Release|Any CPU.ActiveCfg = Release|Any CPU
		{{ proj.projectguid }}.Release|Any CPU.Build.0 = Release|Any CPU
{{~ end ~}}
{{~ end ~}}