using Microsoft.EntityFrameworkCore;
using {{settings.namespace}}.Data;
using {{settings.namespace}}.Contracts;
using {{settings.namespace}}.Entities;

namespace {{settings.namespace}}.Repositories;

public class {{tablename}}Repository : I{{tablename}}Repository
{
    private readonly AppDbContext _dbContext;

    public {{tablename}}Repository(AppDbContext dbContext)
    {
        _dbContext = dbContext;
    }

    public async Task<IEnumerable<{{tablename}}Entity>> GetAllAsync()
    {
        return await _dbContext.{{tablename}}s.ToListAsync();
    }

    public async Task<{{tablename}}Entity?> GetByIdAsync(int id)
    {
        return await _dbContext.{{tablename}}s.FindAsync(id);
    }

    public async Task<{{tablename}}Entity> AddAsync({{tablename}}Entity entity)
    {
        _dbContext.{{tablename}}s.Add(entity);
        await _dbContext.SaveChangesAsync();
        return entity;
    }

    public async Task<bool> UpdateAsync({{tablename}}Entity entity)
    {
        _dbContext.{{tablename}}s.Update(entity);
        return await _dbContext.SaveChangesAsync() > 0;
    }

    public async Task<bool> DeleteAsync(int id)
    {
        var entity = await _dbContext.{{tablename}}s.FindAsync(id);
        if (entity == null)
            return false;

        _dbContext.{{tablename}}s.Remove(entity);
        return await _dbContext.SaveChangesAsync() > 0;
