{
  "ConnectionStrings": {

    "DefaultConnection":
    "Server=.;Database={{settings.database}};Trusted_Connection=True;TrustServerCertificate=True"

  },


  "Logging": {

    "LogLevel": {

      "Default": "Information",

      "Microsoft.AspNetCore": "Warning"

    }

  },


  "AllowedHosts": "*"

}