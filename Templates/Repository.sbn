using Microsoft.EntityFrameworkCore;
using <Your Namespace>.Data;
using <Your Namespace>.Contracts;
using <Your Namespace>.Entities;
using System.Diagnostics.Eventing.Reader;

namespace <Your Namespace>.Repositories
public class {{table_name}Repository : I{{table_name}}}Repository
{
		private readonly AppDbContext _dbContext;

        public {{table_name}}Repository(AppDbContext dbContext)
        {
            _dbContext = dbContext;
        }

        public async Task<IEnumerable<{{table_name}}Entity>> GetAllAsync()
        { 
            return await _dbContext.Products.ToListAsync();
        }
        public async Task<{{table_name}}Entity?> GetByIdAsync(int id)
        {
            return await _dbContext.{{table_name}}s.FindAsync(id);
        }

        public async Task<{{table_name}}Entity> CreateAsync({{table_name}}Entity entiry)
        { 
            _dbContext.{{table_name}}s.Add(entiry);    
            await _dbContext.SaveChangesAsync();
            return entiry;
        }
        public async Task<bool> UpdateAsync({{table_name}}Entity entity)
        {
            _dbContext.{{table_name}}s.Update(entity);
            return await _dbContext.SaveChangesAsync() > 0;
        }

        public async Task<bool> DeleteAsync(int id)
        {
            var entity = await _dbContext.{{table_name}}s.FindAsync(id);
            if (entity == null) 
                return false;

            _dbContext.{{table_name}}s.Remove(entity);
            return await _dbContext.SaveChangesAsync() > 0;             
        }
}