    [ProducesResponseType(StatusCodes.Status401Unauthorized)]
    [ProducesResponseType(StatusCodes.Status500InternalServerError)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<IActionResult> GetAll()
    {
        try
        {
            _logger.LogInformation("GetAll {{tablename}} started");

            var data = await _service.GetAllAsync();

            _logger.LogInformation("GetAll {{tablename}} completed successfully");

            return Ok(new ApiResponse<IEnumerable<{{tablename}}Dto>>
            {
                Success = true,
                Message = "{{tablename}} retrieved successfully",
                Data = data
            });
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error occurred in GetAll {{tablename}}");

            return StatusCode(500, new ApiResponse<string>
            {
                Success = false,
                Message = "Error retrieving {{tablename}}",
                Error = new ApiError
