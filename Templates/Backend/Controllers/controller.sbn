    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<IActionResult> Update(int id, [FromBody] {{tablename}}Dto dto)
    {
        try
        {
            _logger.LogInformation("Update {{tablename}} started for Id: {Id}", id);

            dto.Id = id;

            var updated = await _service.UpdateAsync(dto);

            if (!updated)
            {
                _logger.LogWarning("Update failed - {{tablename}} not found for Id: {Id}", id);

                return NotFound(new ApiResponse<string>
                {
                    Success = false,
                    Message = "{{tablename}} not found"
                });
            }

            return Ok(new ApiResponse<string>
            {
                Success = true,
                Message = "{{tablename}} updated successfully"
