    public async Task<IActionResult> Create([FromBody] {{tablename}}Dto dto)
    {
        try
        {
            _logger.LogInformation("Create {{tablename}} started");

            var result = await _service.AddAsync(dto);

            _logger.LogInformation("Create {{tablename}} completed");

            return CreatedAtAction(
                nameof(GetById),
                new { id = result.Id },
                new ApiResponse<{{tablename}}Dto>
                {
                    Success = true,
                    Message = "{{tablename}} created successfully",
